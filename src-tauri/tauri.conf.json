{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Michie",
  "version": "1.0.0-beta7",
  "identifier": "com.michie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Michie",
        "width": 1450,
        "height": 1000,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": [
          "https://fonts.gstatic.com"
        ],
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "media-src": "'self' asset: http://asset.localhost"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/db/**",
            "$RESOURCE/**",
            "$HOME/.config/**",
            "/src/images/**"
          ],
          "deny": [
            "$APPDATA/db/*.stronghold"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "rpm",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "category": "Music",
    "copyright": "copyright",
    "shortDescription": "A beautiful music player made with Tauri and React",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ]
      },
      {
        "ext": [
          "m4a"
        ]
      },
      {
        "ext": [
          "flac"
        ]
      },
      {
        "ext": [
          "wav"
        ]
      },
      {
        "ext": [
          "ogg"
        ]
      },
      {
        "ext": [
          "opus"
        ]
      },
      {
        "ext": [
          "aac"
        ]
      },
      {
        "ext": [
          "aiff"
        ]
      }
    ],
    "windows": {
      "allowDowngrades": true,
      "signCommand": null,
      "tsp": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.ico",
        "sidebarImage": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "offlineInstaller"
      },
      "wix": {
        "language": "en-US",
        "dialogImagePath": "wix/dialogImage.jpg",
        "bannerPath": "wix/bannerImage.jpg"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MEZDRTk5ODQxMUEwNEMKUldSTW9CR0VtYzRQU083dDZQWXNhalZyemV6TmNPeGJUelVaclNvSXR5WkdmNFdlc3ZXY1NFYVgK",
      "endpoints": [
        "https://github.com/excebymn/michie/releases/latest/download/latest.json"
      ]
    }
  }
}